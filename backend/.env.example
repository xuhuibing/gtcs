# GTCS 环境变量配置
# 复制此文件为 .env 并修改相关配置

# 应用配置
APP_NAME=GTCS全球贸易通关系统
APP_VERSION=2.0.0
DEBUG=false

# 数据库
DATABASE_URL=sqlite:///data/gtcs.db

# JWT 密钥
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
